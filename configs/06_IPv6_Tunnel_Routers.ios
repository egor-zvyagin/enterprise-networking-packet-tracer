! ==============================================================================
! Cisco IOS Configuration: 06_IPv6_Tunnel_Routers.ios
! Devices: R0v6 & R1v6 (Dual-Stack Edge Routers with IPv6-in-IPv4 Manual Tunnel)
! Author: Egor Zvyagin | Melbourne, VIC
! Architecture: IPv6 Over IPv4 Overlay Tunnelling, Loopback Testing, Root-Cause Analysis
! ==============================================================================
!
! ------------------------------------------------------------------------------
! ROOT CAUSE ANALYSIS & 3 PRE-CONFIGURED ISSUES RESOLVED:
! 1. Tunnel Encapsulation Mode Mismatch:
!    The tunnel interface was missing 'tunnel mode ipv6ip' (defaulting to GRE IPv4),
!    preventing native IPv6 payload decapsulation across the IPv4 transit network.
! 2. Incorrect Tunnel Source Interface:
!    The tunnel source on R0v6 pointed to an administratively shut interface (FastEthernet0/0)
!    instead of the active transit Serial interface (Serial0/0/0).
! 3. Inverted / Incorrect Tunnel Destination IP:
!    The tunnel destination on R1v6 was incorrectly pointed to its own local IP
!    instead of R0v6's remote Serial IPv4 endpoint (192.0.2.1).
! ------------------------------------------------------------------------------

! ==============================================================================
! ROUTER: R0v6 Configuration
! ==============================================================================
version 15.4
hostname R0v6
!
ipv6 unicast-routing
!
! Transit IPv4 WAN Interface
interface Serial0/0/0
 description TRANSIT-IPV4-CARRIER-LINK
 ip address 192.0.2.1 255.255.255.252
 clock rate 64000
 no shutdown
!
! Local IPv6 Loopback Network (Endpoint to be pinged)
interface Loopback0
 description R0v6-IPV6-TEST-NETWORK
 ipv6 address 2001:DB8:ACAD:1000::1/64
 no shutdown
!
! Corrected IPv6-in-IPv4 Manual Tunnel
interface Tunnel0
 description IPV6-MANUAL-TUNNEL-TO-R1v6
 no ip address
 ipv6 address 2001:DB8:CAFE:1::1/64
 tunnel source Serial0/0/0
 tunnel destination 192.0.2.2
 tunnel mode ipv6ip
 no shutdown
!
! Pre-configured IPv6 Default Route through Tunnel0 (Do Not Change)
ipv6 route ::/0 Tunnel0
!

! ==============================================================================
! ROUTER: R1v6 Configuration
! ==============================================================================
version 15.4
hostname R1v6
!
ipv6 unicast-routing
!
! Transit IPv4 WAN Interface
interface Serial0/0/0
 description TRANSIT-IPV4-CARRIER-LINK
 ip address 192.0.2.2 255.255.255.252
 no shutdown
!
! Local IPv6 Loopback Network (Endpoint initiating verification ping)
interface Loopback1
 description R1v6-IPV6-TEST-NETWORK
 ipv6 address 2001:DB8:ACAD:2000::1/64
 no shutdown
!
! Corrected IPv6-in-IPv4 Manual Tunnel
interface Tunnel0
 description IPV6-MANUAL-TUNNEL-TO-R0v6
 no ip address
 ipv6 address 2001:DB8:CAFE:1::2/64
 tunnel source Serial0/0/0
 tunnel destination 192.0.2.1
 tunnel mode ipv6ip
 no shutdown
!
! Pre-configured IPv6 Default Route through Tunnel0 (Do Not Change)
ipv6 route ::/0 Tunnel0
!

! ==============================================================================
! CLI VERIFICATION & CONFIRMATION
! ==============================================================================
! Verification command executed from R1v6 CLI:
!
! R1v6# ping ipv6 2001:DB8:ACAD:1000::1 source Loopback1
! Type escape sequence to abort.
! Sending 5, 100-byte ICMP Echos to 2001:DB8:ACAD:1000::1, timeout is 2 seconds:
! Packet sent with a source address of 2001:DB8:ACAD:2000::1
! !!!!!
! Success rate is 100 percent (5/5), round-trip min/avg/max = 2/3/5 ms
! ==============================================================================
